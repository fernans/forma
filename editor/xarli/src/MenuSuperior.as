package {	import flash.desktop.NativeApplication;	import flash.display.MovieClip;	import flash.display.NativeMenu;	import flash.display.NativeMenuItem;	import flash.display.NativeWindow;	import flash.events.Event;	import flash.events.MouseEvent;	import flash.ui.Keyboard;		public class MenuSuperior extends MovieClip	{				private var menuRoot:NativeMenu;				public var padre:MovieClip;				/* Primer Menu */		private var nuevoItem:NativeMenuItem;		private var abrirItem:NativeMenuItem;		private var guardarItem:NativeMenuItem;		private var guardarcomoItem:NativeMenuItem;		private var exportarItem:NativeMenuItem;		private var salirItem:NativeMenuItem;										/* Segundo Menu */		private var deshacerItem:NativeMenuItem;		private var rehacerItem:NativeMenuItem;		private var cortarItem:NativeMenuItem;		private var copiarItem:NativeMenuItem;		private var pegarItem:NativeMenuItem;				private var anadirItem:NativeMenuItem;		private var quitarItem:NativeMenuItem;				private var subirItem:NativeMenuItem;		private var bajarItem:NativeMenuItem;				private var verItem:NativeMenuItem;		private var opcionesItem:NativeMenuItem;			/* Tercer Menu */		private var ayudaItem:NativeMenuItem;		private var sobreItem:NativeMenuItem;		private var registrarItem:NativeMenuItem;						public function MenuSuperior() 		{		}				/**		 * Create Application (MAC) or Window (Microsoft) menu 		 */		public function init()		{			menuRoot = new NativeMenu();			menuRoot.addItem(menuArchivo());			menuRoot.addItem(menuEdicion());			menuRoot.addItem(menuAyuda());			return menuRoot;						// If we are on Mac OS X			if (NativeApplication.supportsMenu) 				NativeApplication.nativeApplication.menu = menuRoot;						// If we are on Windows			if (NativeWindow.supportsMenu)				stage.nativeWindow.menu = menuRoot;						}		private function menuArchivo():NativeMenuItem		{			var menuNativo:NativeMenuItem = new NativeMenuItem("Archivo");			menuNativo.mnemonicIndex = 0;			menuNativo.submenu = new NativeMenu();						nuevoItem = new NativeMenuItem ("Nuevo");			nuevoItem.addEventListener(Event.SELECT, onSelectItem);			//nuevoItem.keyEquivalentModifiers = [Keyboard.COMMAND];			nuevoItem.keyEquivalent = 'n';			menuNativo.submenu.addItem(nuevoItem);						abrirItem = new NativeMenuItem ("Abrir");			abrirItem.addEventListener(Event.SELECT, onSelectItem);			//abrirItem.keyEquivalentModifiers = [Keyboard.COMMAND];			abrirItem.keyEquivalent = 'o';			menuNativo.submenu.addItem(abrirItem);						guardarItem = new NativeMenuItem ("Guardar");			guardarItem.addEventListener(Event.SELECT, onSelectItem);			//guardarItem.keyEquivalentModifiers = [Keyboard.COMMAND];			guardarItem.keyEquivalent = 's';			menuNativo.submenu.addItem(guardarItem);						guardarcomoItem = new NativeMenuItem ("Guardar como");			guardarcomoItem.addEventListener(Event.SELECT, onSelectItem);			//guardarcomoItem.keyEquivalentModifiers = [Keyboard.COMMAND, Keyboard.SHIFT];			guardarcomoItem.keyEquivalent = 'S';			menuNativo.submenu.addItem(guardarcomoItem);						var separator:NativeMenuItem = new NativeMenuItem ("", true);			menuNativo.submenu.addItem(separator);			exportarItem = new NativeMenuItem ("Exportar Presentacion");			exportarItem.addEventListener(Event.SELECT, onSelectItem);			//exportarItem.keyEquivalentModifiers = [Keyboard.COMMAND, Keyboard.SHIFT];			exportarItem.keyEquivalent = 'e';			menuNativo.submenu.addItem(exportarItem);						var separator2:NativeMenuItem = new NativeMenuItem ("", true);			menuNativo.submenu.addItem(separator2);						salirItem = new NativeMenuItem ("Salir");			salirItem.addEventListener(Event.SELECT, onSelectItem);			//salirItem.keyEquivalentModifiers = [Keyboard.COMMAND];			salirItem.keyEquivalent = 'q';			menuNativo.submenu.addItem(salirItem);						return menuNativo;		}				private function menuEdicion():NativeMenuItem		{			var menuNativo:NativeMenuItem = new NativeMenuItem("Edición");			menuNativo.mnemonicIndex = 0;			menuNativo.submenu = new NativeMenu();						deshacerItem = new NativeMenuItem ("Deshacer");			deshacerItem.addEventListener(Event.SELECT, onSelectItem);			//deshacerItem.keyEquivalentModifiers = [Keyboard.COMMAND];			deshacerItem.keyEquivalent = 'z';			menuNativo.submenu.addItem(deshacerItem);						rehacerItem = new NativeMenuItem ("Rehacer");			rehacerItem.addEventListener(Event.SELECT, onSelectItem);			//rehacerItem.keyEquivalentModifiers = [Keyboard.COMMAND];			rehacerItem.keyEquivalent = 'y';			menuNativo.submenu.addItem(rehacerItem);									copiarItem = new NativeMenuItem ("Copiar");			copiarItem.addEventListener(Event.SELECT, onSelectItem);			//copiarItem.keyEquivalentModifiers = [Keyboard.COMMAND];			copiarItem.keyEquivalent = 'c';			menuNativo.submenu.addItem(copiarItem);						cortarItem = new NativeMenuItem ("Cortar");			cortarItem.addEventListener(Event.SELECT, onSelectItem);			//cortarItem.keyEquivalentModifiers = [Keyboard.COMMAND];			cortarItem.keyEquivalent = 'x';			menuNativo.submenu.addItem(cortarItem);						pegarItem = new NativeMenuItem ("Pegar");			pegarItem.addEventListener(Event.SELECT, onSelectItem);			//pegarItem.keyEquivalentModifiers = [Keyboard.COMMAND];			pegarItem.keyEquivalent = 'v';			menuNativo.submenu.addItem(pegarItem);			var separator:NativeMenuItem = new NativeMenuItem ("", true);			menuNativo.submenu.addItem(separator)						anadirItem = new NativeMenuItem ("Añadir");			anadirItem.addEventListener(Event.SELECT, onSelectItem);			//anadirItem.keyEquivalentModifiers = [Keyboard.COMMAND];			anadirItem.keyEquivalent = Keyboard.KEYNAME_INSERT;			menuNativo.submenu.addItem(anadirItem);						quitarItem = new NativeMenuItem ("Quitar");			quitarItem.addEventListener(Event.SELECT, onSelectItem);			quitarItem.keyEquivalentModifiers = [];			quitarItem.keyEquivalent = Keyboard.KEYNAME_DELETE;			menuNativo.submenu.addItem(quitarItem);			var separator1:NativeMenuItem = new NativeMenuItem ("", true);			menuNativo.submenu.addItem(separator1);			subirItem = new NativeMenuItem ("Subir");			subirItem.addEventListener(Event.SELECT, onSelectItem);			//subirItem.keyEquivalentModifiers = [Keyboard.COMMAND];			subirItem.keyEquivalent = Keyboard.KEYNAME_PAGEUP;			menuNativo.submenu.addItem(subirItem);						bajarItem = new NativeMenuItem ("Bajar");			bajarItem.addEventListener(Event.SELECT, onSelectItem);			//bajarItem.keyEquivalentModifiers = [Keyboard.COMMAND];			bajarItem.keyEquivalent = Keyboard.KEYNAME_PAGEDOWN;			menuNativo.submenu.addItem(bajarItem);			var separator2:NativeMenuItem = new NativeMenuItem ("", true);			menuNativo.submenu.addItem(separator2);			verItem = new NativeMenuItem ("Ver Presentación");			verItem.addEventListener(Event.SELECT, onSelectItem);			verItem.keyEquivalentModifiers = [];			verItem.keyEquivalent = Keyboard.KEYNAME_F5;			menuNativo.submenu.addItem(verItem);			var separator3:NativeMenuItem = new NativeMenuItem ("", true);			menuNativo.submenu.addItem(separator3);			opcionesItem = new NativeMenuItem ("Opciones");			opcionesItem.addEventListener(Event.SELECT, onSelectItem);			//opcionesItem.keyEquivalentModifiers = [Keyboard.COMMAND];			opcionesItem.keyEquivalent = 'k';			menuNativo.submenu.addItem(opcionesItem);			return menuNativo;		}				private function menuAyuda():NativeMenuItem		{			var menuNativo:NativeMenuItem = new NativeMenuItem("Ayuda");			menuNativo.mnemonicIndex = 1;			menuNativo.submenu = new NativeMenu();						ayudaItem = new NativeMenuItem ("Ayuda");			ayudaItem.addEventListener(Event.SELECT, onSelectItem);			ayudaItem.keyEquivalentModifiers = [];			ayudaItem.keyEquivalent = Keyboard.KEYNAME_F1;			menuNativo.submenu.addItem(ayudaItem);						sobreItem = new NativeMenuItem ("Sobre Forma 3D Presentation");			sobreItem.addEventListener(Event.SELECT, onSelectItem);			menuNativo.submenu.addItem(sobreItem);						var separator:NativeMenuItem = new NativeMenuItem ("", true);			menuNativo.submenu.addItem(separator);						registrarItem = new NativeMenuItem ("Registrar Producto");			registrarItem.addEventListener(Event.SELECT, onSelectItem);			menuNativo.submenu.addItem(registrarItem);						return menuNativo;		}				private function onSelectItem(e:Event):void 		{			var item:NativeMenuItem = e.target as NativeMenuItem			switch(item) {							case nuevoItem:					MovieClip(padre).nuevoArchivo();					break;				case abrirItem:					MovieClip(padre).abrirArchivo();					break;				case guardarItem:					MovieClip(padre).guardarArchivo();					break;				case guardarcomoItem:					MovieClip(padre).guardarComoArchivo();					break;				case exportarItem:					MovieClip(padre).exportar();					break;				case salirItem:					NativeApplication.nativeApplication.exit()					break;										case deshacerItem:					MovieClip(padre).deshacer();					break;				case rehacerItem:					MovieClip(padre).rehacer();					break;				case cortarItem:					MovieClip(padre).cortar();					break;				case copiarItem:					MovieClip(padre).copiar();					break;				case pegarItem:					MovieClip(padre).pegar();					break;				case anadirItem:					MovieClip(padre).nuevaDiapositiva();					break;				case quitarItem:					MovieClip(padre).eliminarDiapositiva();					break;				case subirItem:					MovieClip(padre).subirDiapositiva();					break;				case bajarItem:					MovieClip(padre).bajarDiapositiva();					break;								case verItem:					break;				case opcionesItem:					MovieClip(padre).cargarOpciones();					break;							case ayudaItem:					break;				case sobreItem:					break;				case registrarItem:					break;			}					}					}}