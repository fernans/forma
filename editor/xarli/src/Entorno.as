package {	import flash.display.Bitmap;	import flash.display.Loader;	import flash.display.MovieClip;	import flash.events.Event;	import flash.events.MouseEvent;	import flash.filesystem.File;	import flash.filesystem.FileMode;	import flash.filesystem.FileStream;	import flash.net.URLRequest;		import com.greensock.TweenLite;	import com.greensock.easing.*;	import com.greensock.plugins.*;		public class Entorno extends MovieClip	{		private var ficheroMarcos:File;		private var ficheroEscenarios:File;		private var seleccionadoEscenario:Escenario = null;		private var seleccionadoMarco:Marco = null;		private var numArriba:Number = 0;		private var numAbajo:Number = 0;				public function Entorno(){			addEventListener(Event.ADDED_TO_STAGE, init);		}				public function init(e:Event){			escenarios.mask = mascescenario;			marcos.mask = mascmarcos;						flechaIzqArriba.addEventListener(MouseEvent.CLICK, onClick);			flechaDerArriba.addEventListener(MouseEvent.CLICK, onClick);			flechaIzqAbajo.addEventListener(MouseEvent.CLICK, onClick);			flechaDerAbajo.addEventListener(MouseEvent.CLICK, onClick);			flechaIzqArriba.buttonMode = true;			flechaDerArriba.buttonMode = true;			flechaIzqAbajo.buttonMode = true;			flechaDerAbajo.buttonMode = true;						trace(File.applicationDirectory.nativePath);						ficheroEscenarios = File.applicationDirectory.resolvePath("config/Escenarios.xml");			var fileStream:FileStream = new FileStream(); 			fileStream.open(ficheroEscenarios, FileMode.READ);			var xml:XML = new XML(fileStream.readUTFBytes(fileStream.bytesAvailable));			fileStream.close();						for(var i:int = 0; i<xml.escenario.length(); i++){				var hijo:Escenario = new Escenario(xml.escenario[i]);				hijo.x = 303*i;				escenarios.addChild(hijo);			}			seleccionarEscenario(escenarios.getChildAt(0) as Escenario);			actualizarFlechasEscenarios();						ficheroMarcos = File.applicationDirectory.resolvePath("config/Marcos.xml");			fileStream = new FileStream(); 			fileStream.open(ficheroMarcos, FileMode.READ);			xml = new XML(fileStream.readUTFBytes(fileStream.bytesAvailable));			fileStream.close();						for(i = 0; i<xml.marco.length(); i++){				var hijomarco:Marco = new Marco(xml.marco[i].@nombre, xml.marco[i].@id, xml.marco[i].@imagen);				hijomarco.x = 205*i;				marcos.addChild(hijomarco);			}			seleccionarMarco(marcos.getChildAt(0) as Marco);			actualizarFlechasMarcos();		}				public function seleccionarEscenario(escenario:Escenario){			for(var i:int = 0; i<escenarios.numChildren; i++){				var hijo:Escenario = escenarios.getChildAt(i) as Escenario;				if(hijo == escenario){					hijo.alpha = 1;					seleccionadoEscenario = hijo;				} else {					hijo.alpha = 0.5;				}			}		}		public function seleccionarMarco(marco:Marco){			for(var i:int = 0; i<marcos.numChildren; i++){				var hijo:Marco = marcos.getChildAt(i) as Marco;				if(hijo == marco){					hijo.alpha = 1;					seleccionadoMarco = hijo;				} else {					hijo.alpha = 0.5;				}			}		}				public function aXMLAlt():String{			var cadena:String = '';			cadena += seleccionadoEscenario.aXML();			cadena += seleccionadoMarco.aXML();			/*cadena += '<opcion nombre="camara" valor="' + RadioButtonGroup.getGroup("Camara").selectedData +'" />';			cadena += '<opcion nombre="antialiasing" valor="' + RadioButtonGroup.getGroup("AntiAliasing").selectedData +'" />';			cadena += '<opcion nombre="vsync" valor="' + RadioButtonGroup.getGroup("Vsync").selectedData +'" />';*/			return cadena;		}						public function onClick(evt:MouseEvent){			switch(evt.currentTarget){				case flechaIzqArriba:					if(numArriba > 0){						numArriba--;						TweenLite.to(escenarios, 0.5, {x:64.75-303*numArriba});						actualizarFlechasEscenarios();					}					break;				case flechaDerArriba:					if(numArriba < escenarios.numChildren-2){						numArriba++;						TweenLite.to(escenarios, 0.5, {x:64.75-303*numArriba});						actualizarFlechasEscenarios();					}					break;				case flechaIzqAbajo:					if(numAbajo > 0){						numAbajo--;						TweenLite.to(marcos, 0.5, {x:86.75-205*numAbajo});						actualizarFlechasMarcos();					}					break;				case flechaDerAbajo:					if(numAbajo < marcos.numChildren-3){						numAbajo++;						TweenLite.to(marcos, 0.5, {x:86.75-205*numAbajo});						actualizarFlechasMarcos();					}					break;			}		}				private function actualizarFlechasEscenarios(){			if(numArriba > 0){				mostrarFlecha(flechaIzqArriba);			} else {				ocultarFlecha(flechaIzqArriba);			}			if(numArriba < escenarios.numChildren-2){				mostrarFlecha(flechaDerArriba);			} else {				ocultarFlecha(flechaDerArriba);			}					}				private function actualizarFlechasMarcos(){			if(numAbajo > 0){				mostrarFlecha(flechaIzqAbajo);			} else {				ocultarFlecha(flechaIzqAbajo);			}			if(numAbajo < marcos.numChildren-3){				mostrarFlecha(flechaDerAbajo);			} else {				ocultarFlecha(flechaDerAbajo);			}					}				private function mostrarFlecha(flecha:MovieClip){			flecha.visible = true;		}				private function ocultarFlecha(flecha:MovieClip){			flecha.visible = false;		}	}}