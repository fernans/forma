package  {		import com.greensock.OverwriteManager;	import com.greensock.TweenLite;	import com.greensock.easing.*;	import com.greensock.plugins.*;		import flash.display.MovieClip;	import flash.events.Event;	import flash.events.MouseEvent;	import flash.geom.Rectangle;	import flash.text.TextField;	import flash.text.TextFieldAutoSize;	import flash.text.TextFormat;	TweenPlugin.activate([AutoAlphaPlugin]);		public class Scroll extends MovieClip {				private var _pelicula:Object;		private var _offset:Number;		private var _activado:Boolean = false;				public function Scroll() {		}				public function init(){			_pelicula = MovieClip(parent).diapositivas;			_offset = MovieClip(parent).diapositivas.y;						this.visible = false;			this.alpha = 0;						boton.buttonMode = true;			boton.addEventListener(MouseEvent.MOUSE_DOWN, _downHandler);		}		private function _enterHandler(e:Event){			var total:int = barra.height - boton.height;			var posFinal:int = _offset - (_pelicula.height - barra.height + 10)*(boton.y/total);			_pelicula.y += (posFinal - _pelicula.y)/6;			//trace(_pelicula.y);		}				private function _downHandler(e:MouseEvent){			boton.startDrag(false, new Rectangle(0,0,0, barra.height-boton.height));			stage.addEventListener(MouseEvent.MOUSE_UP,_upHandler);		}				public function _upHandler(e:MouseEvent = null){			stage.removeEventListener(MouseEvent.MOUSE_UP,_upHandler);			boton.stopDrag();		}		public function activar(){			if(!_activado){				_activado = true;				boton.y = 0;				addEventListener(Event.ENTER_FRAME, _enterHandler);				TweenLite.to(this,0.3,{autoAlpha:1});			}		}				public function desactivar(){			if(_activado){				_activado = false;				removeEventListener(Event.ENTER_FRAME, _enterHandler);				TweenLite.to(this,0.3,{autoAlpha:0});			}		}				public function reescalar(){			var altura:int = barra.height*(barra.height/_pelicula.height);			if(altura > barra.height) altura = barra.height;			if(altura < 30) altura = 30;			TweenLite.to(boton.central,0,{height:altura-4});			TweenLite.to(boton.puntos,0,{y:altura/2});						TweenLite.to(boton.fin,0,{y:altura-4});			if((boton.y + altura) > barra.height){				TweenLite.to(boton,0,{y:barra.height-altura});							}		}				public function mostrar(alto:Number){			boton.y = (alto/(_pelicula.height - barra.height + 10))*(barra.height - boton.height);			if((boton.y + boton.height) > barra.height){				boton.y = barra.height-boton.height;							}		}	}	}