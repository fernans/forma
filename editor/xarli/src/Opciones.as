package  {		import fl.controls.RadioButtonGroup;		import flash.display.DisplayObject;	import flash.display.MovieClip;	import flash.events.Event;	import flash.events.TextEvent;	import flash.filesystem.File;	import flash.filesystem.FileMode;	import flash.filesystem.FileStream;	import flash.text.TextFormat;	import flash.xml.XMLNode;		public class Opciones extends MovieClip {				private var ficheroPreferencias:File;		private var xml:XML;				public function Opciones() {			addEventListener(Event.ADDED_TO_STAGE, init);		}				public function init(e:Event){			xml = null;			removeEventListener(Event.ADDED_TO_STAGE,init);			ficheroPreferencias = File.applicationStorageDirectory.resolvePath("preferenciasForma.xml");			if(!ficheroPreferencias.exists || !cargarConfig()){				trace("Creo la configuracion basica");				RadioButtonGroup.getGroup("Resolucion").selection = Resolucion1;				RadioButtonGroup.getGroup("Camara").selection = Camara1;				RadioButtonGroup.getGroup("Aspecto").selection = Aspecto1;				RadioButtonGroup.getGroup("Idioma").selection = Idioma1;				RadioButtonGroup.getGroup("AntiAliasing").selection = AntiAliasing1;				RadioButtonGroup.getGroup("Vsync").selection = Vsync1;			}			guardarConfig();						RadioButtonGroup.getGroup("Resolucion").addEventListener(Event.CHANGE, onChange);			RadioButtonGroup.getGroup("Camara").addEventListener(Event.CHANGE, onChange);			RadioButtonGroup.getGroup("Aspecto").addEventListener(Event.CHANGE, onChange);			RadioButtonGroup.getGroup("Idioma").addEventListener(Event.CHANGE, onChange);			RadioButtonGroup.getGroup("AntiAliasing").addEventListener(Event.CHANGE, onChange);			RadioButtonGroup.getGroup("Vsync").addEventListener(Event.CHANGE, onChange);			relancho.addEventListener(Event.CHANGE, onInput);			relalto.addEventListener(Event.CHANGE, onInput);			ancho.addEventListener(Event.CHANGE, onInput);			alto.addEventListener(Event.CHANGE, onInput);						for(var i:int = 0; i < numChildren; i++){				var item:DisplayObject = getChildAt(i);				if(item is RadioButton){					var tf:TextFormat = new TextFormat();					tf.color = 0xFFFFFF;					tf.font = "Tahoma";					tf.size = 11;					tf.letterSpacing = 1;					RadioButton(item).setStyle("textFormat",tf);				}							}		}				public function cargarConfig(_xml:XML = null):Boolean{			try{				trace("Cargo XML");				if(_xml == null){					var fileStream:FileStream = new FileStream(); 					fileStream.open(ficheroPreferencias, FileMode.READ);					xml = new XML(fileStream.readUTFBytes(fileStream.bytesAvailable));					fileStream.close();				}else {					xml = new XML(_xml);				}			}catch (error:Error){				trace("Fallo al cargar la configuración", error.message);				return false;			}						if(getChildByName("Resolucion"+xml.resolucion.@value)){				RadioButtonGroup.getGroup("Resolucion").selection = getChildByName("Resolucion"+xml.resolucion.@value) as RadioButton;				if(xml.resolucion.@value == "7"){					ancho.text = String(uint(xml.resolucion.@ancho));					alto.text = String(uint(xml.resolucion.@alto));				}			} else {				RadioButtonGroup.getGroup("Resolucion").selection = Resolucion1;			}						if(getChildByName("Camara"+xml.camara.@value)){				RadioButtonGroup.getGroup("Camara").selection = getChildByName("Camara"+xml.camara.@value) as RadioButton;			} else {				RadioButtonGroup.getGroup("Camara").selection = Camara1;			}						if(getChildByName("Aspecto"+xml.aspecto.@value)){				RadioButtonGroup.getGroup("Aspecto").selection = getChildByName("Aspecto"+xml.aspecto.@value) as RadioButton;				if(xml.aspecto.@value == "3"){					relancho.text = String(uint(xml.aspecto.@ancho));					relalto.text = String(uint(xml.aspecto.@alto));				}			} else {				RadioButtonGroup.getGroup("Aspecto").selection = Aspecto1;			}						if(getChildByName("Idioma"+xml.idioma.@value)){				RadioButtonGroup.getGroup("Idioma").selection = getChildByName("Idioma"+xml.idioma.@value) as RadioButton;			} else {				RadioButtonGroup.getGroup("Idioma").selection = Idioma1;			}						if(getChildByName("AntiAliasing"+xml.antialiasing.@value)){				RadioButtonGroup.getGroup("AntiAliasing").selection = getChildByName("AntiAliasing"+xml.antialiasing.@value) as RadioButton;			} else {				RadioButtonGroup.getGroup("AntiAliasing").selection = AntiAliasing1;			}						if(getChildByName("Vsync"+xml.vsync.@value)){				RadioButtonGroup.getGroup("Vsync").selection = getChildByName("Vsync"+xml.vsync.@value) as RadioButton;			} else {				RadioButtonGroup.getGroup("Vsync").selection = Vsync1;			}			return true;		}				private function guardarConfig(){			trace("Guardo XML");			xml = new XML('<xml>' + aXML() + '</xml>');			var fileStream:FileStream = new FileStream(); 			fileStream.open(ficheroPreferencias, FileMode.WRITE);			fileStream.writeMultiByte(String('<xml>' + aXML() + '</xml>'), "utf-8");			fileStream.close();		}				public function aXML():String{			var cadena:String = '<resolucion value="' + RadioButtonGroup.getGroup("Resolucion").selectedData +'" alto="' + alto.text + '" ancho="' + ancho.text + '" />' +				'<camara value="' + RadioButtonGroup.getGroup("Camara").selectedData +'" />' +				'<aspecto value="' + RadioButtonGroup.getGroup("Aspecto").selectedData +'" alto="' + relalto.text + '" ancho="' + relancho.text + '" />' +				'<idioma value="' + RadioButtonGroup.getGroup("Idioma").selectedData +'" />' +				'<antialiasing value="' + RadioButtonGroup.getGroup("AntiAliasing").selectedData +'" />' +				'<vsync value="' + RadioButtonGroup.getGroup("Vsync").selectedData +'" />';			return cadena;		}				public function aXMLAlt():String{			var cadena:String = '';			switch(RadioButtonGroup.getGroup("Resolucion").selectedData){				case "1":					cadena += '<opcion nombre="resolucionx" valor="800" />';					cadena += '<opcion nombre="resoluciony" valor="600" />';					break;				case "2":					cadena += '<opcion nombre="resolucionx" valor="1024" />';					cadena += '<opcion nombre="resoluciony" valor="768" />';					break;				case "3":					cadena += '<opcion nombre="resolucionx" valor="1280" />';					cadena += '<opcion nombre="resoluciony" valor="1024" />';					break;				case "4":					cadena += '<opcion nombre="resolucionx" valor="960" />';					cadena += '<opcion nombre="resoluciony" valor="540" />';					break;				case "5":					cadena += '<opcion nombre="resolucionx" valor="1280" />';					cadena += '<opcion nombre="resoluciony" valor="720" />';					break;				case "6":					cadena += '<opcion nombre="resolucionx" valor="1920" />';					cadena += '<opcion nombre="resoluciony" valor="1080" />';					break;				case "7":					cadena += '<opcion nombre="resolucionx" valor="' + ancho.text  + '" />';					cadena += '<opcion nombre="resoluciony" valor="' + alto.text + '" />';					break;			}			switch(RadioButtonGroup.getGroup("Aspecto").selectedData){				case "1":					cadena += '<opcion nombre="aspectox" valor="4" />';					cadena += '<opcion nombre="aspectoy" valor="3" />';					break;				case "2":					cadena += '<opcion nombre="aspectox" valor="16" />';					cadena += '<opcion nombre="aspectoy" valor="9" />';				break;				case "3":					cadena += '<opcion nombre="aspectox" valor="'+relancho.text+'" />';					cadena += '<opcion nombre="aspectoy" valor="'+relalto.text+'" />';				break;			}			cadena += '<opcion nombre="camara" valor="' + RadioButtonGroup.getGroup("Camara").selectedData +'" />';			cadena += '<opcion nombre="antialiasing" valor="' + RadioButtonGroup.getGroup("AntiAliasing").selectedData +'" />';			cadena += '<opcion nombre="vsync" valor="' + RadioButtonGroup.getGroup("Vsync").selectedData +'" />';			return cadena;		}				private function onChange(e:Event){			trace("onChange");			if(!Aspecto3.selected){				relancho.text = relalto.text = "";			} else {				relancho.text = String(uint(relancho.text));				relalto.text = String(uint(relalto.text));			}			if(!Resolucion7.selected){				ancho.text = alto.text = "";							} else {				ancho.text = String(uint(ancho.text));				alto.text = String(uint(alto.text));			}			guardarConfig();		}				private function onInput(e:Event){			trace("onInput");			switch(e.target){				case relancho:				case relalto:					RadioButtonGroup.getGroup("Aspecto").selection = Aspecto3;					relancho.text = String(uint(relancho.text));					relalto.text = String(uint(relalto.text));					break;				case ancho:				case alto:					RadioButtonGroup.getGroup("Resolucion").selection = Resolucion7;					ancho.text = String(uint(ancho.text));					alto.text = String(uint(alto.text));					break;								}			guardarConfig();		}	}}