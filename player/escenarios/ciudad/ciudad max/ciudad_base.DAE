    <effect id="whj">
      <profile_COMMON>
        <newparam sid="Object02CompleteMap_tga-surface">
          <surface type="2D">
            <init_from>Object02CompleteMap_tga</init_from>
          </surface>
        </newparam>
        <newparam sid="Object02CompleteMap_tga-sampler">
          <sampler2D>
            <source>Object02CompleteMap_tga-surface</source>
          </sampler2D>
